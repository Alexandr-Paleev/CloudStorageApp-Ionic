{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  /* libs/ holds what the handlers share: libs/server, and libs/core, which the
     app uses as well. Neither lives under api/, because Vercel turns every
     file there into its own Serverless Function, and the Hobby plan allows at
     most 12 per deployment. */
  "include": ["api", "libs", "vitest.config.mts"]
}
