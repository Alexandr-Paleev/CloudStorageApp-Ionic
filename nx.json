{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "neverConnectToCloud": true,
  "analytics": false,
  "useDaemonProcess": false,
  "pluginsConfig": {
    "@nx/js": { "analyzeSourceFiles": true }
  },
  "namedInputs": {
    "envFiles": [{ "runtime": "node scripts/env-fingerprint.mjs" }],
    "root": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/api/**/*",
      "{workspaceRoot}/libs/**/*",
      "envFiles"
    ],
    "project": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/.github/workflows/ci.yml"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["root"],
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": { "cache": true, "inputs": ["root"] },
    "typecheck": { "cache": true, "inputs": ["root"] },
    "typecheck:api": { "cache": true, "inputs": ["root"] },
    "test": { "cache": true, "inputs": ["root"] },
    "test:coverage": {
      "cache": true,
      "inputs": ["root"],
      "outputs": ["{projectRoot}/coverage"]
    },
    "size": { "dependsOn": ["build"] },
    "smoke": { "dependsOn": ["build"] },
    "lighthouse": { "dependsOn": ["build"] }
  }
}
