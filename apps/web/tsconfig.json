{
  /* The names of the libraries come from the workspace's own list, so that
     this app, the other one and the lint rule between them read the same
     file. Everything else is what Next asks of a TypeScript project. */
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  /* The tests are type-checked with the rest of the repository's, from the
     root. Here they would make `next build` ask for Vitest, and an install
     of the site alone does not have it. */
  "exclude": ["node_modules", "**/*.test.ts"]
}
