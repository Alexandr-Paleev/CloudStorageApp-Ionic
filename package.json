{
  "name": "cloud-storage-app",
  "version": "4.4.0",
  "author": "Aleksandr Paleev",
  "homepage": "https://github.com/Alexandr-Paleev/CloudStorageApp-Ionic",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alexandr-Paleev/CloudStorageApp-Ionic.git"
  },
  "license": "MIT",
  "keywords": [
    "cloud-storage",
    "file-upload",
    "file-management",
    "ionic",
    "react",
    "pwa",
    "progressive-web-app",
    "typescript",
    "supabase",
    "cloudinary",
    "capacitor",
    "mobile-app",
    "open-source",
    "tanstack-query",
    "vercel"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.build.json --noEmit && tsc --project tsconfig.api.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,scss}\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:api": "tsc --project tsconfig.api.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "generate:icons": "node scripts/generate-icons.js",
    "prepare": "husky",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/check-bundle-size.js",
    "smoke": "node scripts/smoke-built-bundle.mjs",
    "audit:prod": "node scripts/audit-production.mjs",
    "lighthouse": "npx --yes @lhci/cli@0.15 autorun",
    "generate:demo-assets": "node scripts/generate-demo-assets.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/react": "^9.0.2",
    "@sentry/react": "^10.32.1",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.102.8",
    "cloudinary": "^2.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-ga4": "^2.1.0",
    "react-router-dom": "^6.26.0",
    "stripe": "^22.6.1",
    "zod": "^4.3.4"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^9.39.5",
    "@ionic/prettier-config": "^4.0.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/trusted-types": "^2.0.7",
    "@vercel/node": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.0.11",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.3",
    "sharp": "^0.35.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-window": "^7.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "description": "Scalable SaaS Cloud Storage App with Ionic + Supabase + Cloudflare R2"
}
